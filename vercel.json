{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app.api.main:app",
      "installCommand": "pip install -r requirements-api.txt",
      "rewrites": [
        { "source": "/api/:path(.*)?", "destination": "/:path" }
      ],
      "functions": {
        "backend/app/api/main.py": {
          "includeFiles": "{datasets/processed/analogs/**,datasets/processed/soil/**,research/parameters/**,outputs/inputs/**}",
          "excludeFiles": "{frontend/**,.venv/**,datasets/raw/**,docs/**,scripts/**,backend/tests/**,.git/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
